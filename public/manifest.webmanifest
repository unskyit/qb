{
  "name": "QuadBeam — Transfer files through light",
  "short_name": "QuadBeam",
  "description": "Device-to-device optical file transfer using synchronized 4-QR streams, LT Fountain erasure coding, and SHA-256 verification.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#050608",
  "theme_color": "#477FDF",
  "categories": ["utilities", "productivity"],
  "icons": [
    {
      "src": "./icons/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
